<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Section 1: 字幕来源 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="字幕来源"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/selectInternal"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/mobile_surface"
            android:gravity="center"
            android:text="内置字幕"
            android:textColor="@color/dialog_text_primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/selectLocal"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/mobile_surface"
            android:gravity="center"
            android:text="本地字幕"
            android:textColor="@color/dialog_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/selectRemote"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/mobile_surface"
            android:gravity="center"
            android:text="在线搜索"
            android:textColor="@color/dialog_text_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Section 2: 字号大小 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="字号大小"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/mobile_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/subtitleSizeMinus"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="－"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleSizeText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="16"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleSizePlus"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="＋"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Section 3: 样式与位置 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="样式与位置"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/subtitleStyleOne"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/mobile_surface"
            android:gravity="center"
            android:text="字幕样式一"
            android:textColor="@color/dialog_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/subtitlePositionText"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="0%"
            android:textColor="#8E9DAE"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/subtitleStyleTwo"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/mobile_surface"
            android:gravity="center"
            android:text="字幕样式二"
            android:textColor="@color/color_FFB6C1"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Section 4: 字幕延时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="字幕延时"
            android:textColor="#8E9DAE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleTimeHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="仅对外挂字幕有效"
            android:textColor="#5E6F82"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/mobile_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/subtitleTimeMinus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="提前 0.5s"
            android:textColor="#82B1FF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/subtitleTimeText"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleTimePlus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="推迟 0.5s"
            android:textColor="#82B1FF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
