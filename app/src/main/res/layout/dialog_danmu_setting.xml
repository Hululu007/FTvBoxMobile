<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- 在线弹幕搜索 -->
    <TextView
        android:id="@+id/danmuSearch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/mobile_accent"
        android:gravity="center"
        android:text="搜索在线弹幕 ›"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp" />

    <!-- 弹幕速度 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="弹幕速度"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/speed"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:clipChildren="true"
        android:orientation="horizontal"
        app:tv_horizontalSpacingWithMargins="8dp"
        app:tv_layoutManager="V7LinearLayoutManager"
        app:tv_selectedItemIsCentered="false"
        app:tv_verticalSpacingWithMargins="0dp"
        android:layout_marginBottom="14dp" />

    <!-- 弹幕字号 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="弹幕字号"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/mobile_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/sizeSub"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="－"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/size"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sizeAdd"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="＋"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 弹幕行数 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="弹幕行数"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/mobile_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/lineSub"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="－"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/line"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="不限"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lineAdd"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="＋"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 弹幕透明度 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="弹幕透明度"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/mobile_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="3dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/alphaSub"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="－"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alpha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="100%"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/alphaAdd"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/mobile_choice"
            android:gravity="center"
            android:text="＋"
            android:textColor="#82B1FF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 弹幕颜色 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="弹幕颜色"
        android:textColor="#8E9DAE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/trv_color"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:clipChildren="true"
        android:orientation="horizontal"
        app:tv_horizontalSpacingWithMargins="8dp"
        app:tv_layoutManager="V7LinearLayoutManager"
        app:tv_selectedItemIsCentered="false"
        app:tv_verticalSpacingWithMargins="0dp" />

</LinearLayout>
